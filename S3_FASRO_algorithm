import numpy as np


def fasro(F_list, n, packet_loss_rate, retransmission_count,
          patience_limit, fidelity_threshold, relaxation_step,
          fth_min, rng):
    """
    Failure-Aware Selective Retransmission Optimisation.

    Parameters
    ----------
    F_list : list of int
        Zero-based indices of failed receivers requiring retransmission.
    n : int
        Total number of receivers.
    packet_loss_rate : float
        Per-link packet loss probability lambda.
    retransmission_count : int
        Current retransmission count r.
    patience_limit : int
        Rp_limit — retransmissions before adaptive relaxation activates.
    fidelity_threshold : float
        Current Fth (may be updated by relaxation).
    relaxation_step : float
        Delta — Fth reduction per relaxation step (e.g. 0.02).
    fth_min : float
        Fth_min — minimum allowable fidelity threshold (e.g. 0.70).
    rng : numpy.random.Generator
        Seeded RNG for reproducibility.

    Returns
    -------
    updated_states : dict
        {receiver_index: new_qi} for all retransmitted receivers.
    fidelity_threshold : float
        Updated Fth (relaxed if applicable, else unchanged).
    retransmission_packets : int
        Number of packets sent = f.
    retransmission_saving_pct : float
        Saving vs full broadcast retransmission to all n receivers (%).
    log_messages : list of str
        Status log for this FASRO invocation.
    """
    log = []
    f = len(F_list)

    # Steps 1-3: nothing to retransmit
    if f == 0:
        return {}, fidelity_threshold, 0, 100.0, \
               ["FASRO: F_list empty — no retransmission needed. Gc=1"]

    # Steps 4-7: adaptive threshold relaxation
    if retransmission_count > patience_limit and fidelity_threshold > fth_min:
        old = fidelity_threshold
        fidelity_threshold = max(fidelity_threshold - relaxation_step, fth_min)
        log.append(f"FASRO: Adaptive relaxation — "
                   f"Fth {old:.2f} → {fidelity_threshold:.2f}")

    # Steps 8-11: selective retransmission — O(f)
    updated_states = {}
    for idx in F_list:
        updated_states[idx] = 1 if rng.random() > packet_loss_rate else 0

    # Saving vs broadcast (broadcast would send to all n)
    saving_pct = ((n - f) / n) * 100.0
    log.append(f"FASRO: Retransmitted to {f}/{n} receivers. "
               f"Saving={saving_pct:.1f}% vs broadcast. "
               f"Active Fth={fidelity_threshold:.2f}")

    return updated_states, fidelity_threshold, f, saving_pct, log


if __name__ == "__main__":
    rng = np.random.default_rng(42)

    print("=" * 60)
    print("FASRO Examples")
    print("=" * 60)

    print("\n[1] Normal selective retransmission (n=100, 8 failures, λ=1%)")
    F_list = [3, 7, 15, 22, 41, 58, 77, 90]
    updated, fth, count, saving, logs = fasro(
        F_list, n=100, packet_loss_rate=0.01,
        retransmission_count=1, patience_limit=2,
        fidelity_threshold=0.90, relaxation_step=0.02,
        fth_min=0.70, rng=rng)
    print(f"    Packets retransmitted : {count}  (vs 100 broadcast)")
    print(f"    Saving vs broadcast   : {saving:.1f}%")
    print(f"    Updated states        : {updated}")
    for l in logs: print(f"    {l}")

    print("\n[2] Adaptive relaxation triggered (r > Rp_limit)")
    updated, fth, count, saving, logs = fasro(
        [1, 4, 9], n=100, packet_loss_rate=0.05,
        retransmission_count=3, patience_limit=2,
        fidelity_threshold=0.90, relaxation_step=0.02,
        fth_min=0.70, rng=rng)
    print(f"    Fth after relaxation  : {fth:.2f}")
    for l in logs: print(f"    {l}")

    print("\n[3] Empty F_list — no retransmission")
    updated, fth, count, saving, logs = fasro(
        [], n=50, packet_loss_rate=0.01,
        retransmission_count=0, patience_limit=2,
        fidelity_threshold=0.90, relaxation_step=0.02,
        fth_min=0.70, rng=rng)
    for l in logs: print(f"    {l}")
