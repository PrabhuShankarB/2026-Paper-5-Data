def gadce(F, Ec, F_list, fidelity_threshold,
          retransmission_count, max_retransmissions):
    """
    Global ACK Decision and Confirmation Evaluation.

    Parameters
    ----------
    F : float
        Collective fidelity received from CECSF.
    Ec : int
        Collective confirmation state from CECSF (1=success, 0=failure).
    F_list : list of int
        Indices of failed receivers from CECSF.
    fidelity_threshold : float
        Fth — minimum fidelity for global confirmation.
    retransmission_count : int
        Current retransmission count r for this packet round.
    max_retransmissions : int
        Rmax — maximum retransmissions allowed per round.

    Returns
    -------
    Gc : int
        Global confirmation result. 1 = success; 0 = failure/retry.
    retransmission_count : int
        Updated retransmission counter.
    trigger_fasro : bool
        True  → pass F_list to FASRO for selective retransmission.
        False → no retransmission needed (or Rmax exceeded).
    round_failed : bool
        True  → Rmax exceeded; abandon this round, advance to next packet.
    log_message : str
        Human-readable status for this evaluation step.
    """

    # Steps 1-5: Ec=1 means CECSF already confirmed threshold met
    if Ec == 1:
        return 1, retransmission_count, False, False, \
               f"GADCE: Global SUCCESS — Gc=1  (F={F:.4f} >= Fth={fidelity_threshold:.2f})"

    # Steps 6-16: threshold not met
    if retransmission_count < max_retransmissions:
        retransmission_count += 1
        msg = (f"GADCE: FAILED — Gc=0. "
               f"F={F:.4f} < Fth={fidelity_threshold:.2f}. "
               f"Triggering FASRO attempt {retransmission_count}/{max_retransmissions}. "
               f"|F_list|={len(F_list)}")
        return 0, retransmission_count, True, False, msg

    # Rmax exceeded
    msg = (f"GADCE: Rmax={max_retransmissions} reached. "
           f"Round FAILED — advancing to next packet.")
    return 0, retransmission_count, False, True, msg


if __name__ == "__main__":
    print("=" * 60)
    print("GADCE Examples")
    print("=" * 60)

    print("\n[1] Confirmation success (Ec=1)")
    Gc, r, fasro, failed, msg = gadce(0.95, 1, [], 0.90, 0, 3)
    print(f"    Gc={Gc}  FASRO={fasro}  RoundFailed={failed}")
    print(f"    {msg}")

    print("\n[2] First failure — FASRO triggered")
    Gc, r, fasro, failed, msg = gadce(0.82, 0, [3, 7, 12], 0.90, 0, 3)
    print(f"    Gc={Gc}  r={r}  FASRO={fasro}  RoundFailed={failed}")
    print(f"    {msg}")

    print("\n[3] Rmax exceeded — round abandoned")
    Gc, r, fasro, failed, msg = gadce(0.70, 0, [1, 2, 5, 8], 0.90, 3, 3)
    print(f"    Gc={Gc}  FASRO={fasro}  RoundFailed={failed}")
    print(f"    {msg}")
