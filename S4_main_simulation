        (0.05,10),(0.05,100),(0.05,500),
        (0.10,10),(0.10,100),(0.10,500),
    ]
    print("\n"+"="*78)
    print("TABLE 10 — Retransmission: Broadcast TCP vs FASRO Selective")
    print("="*78)
    print(f"{'λ':>5} | {'n':>5} | {'Broadcast':>12} | {'FASRO':>10} | "
          f"{'Saving pkts':>12} | {'Saving%':>8}")
    print("-"*78)
    for lam, n in configs:
        r = run_experiment(n, lam, 0.90)
        print(f"{lam:>5.2f} | {n:>5} | {r['broadcast_retrans']:>12} | "
              f"{r['fasro_retrans']:>10} | {r['retrans_saving_pkts']:>12} | "
              f"{r['retrans_saving_pct']:>8.1f}")


