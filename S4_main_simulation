def print_tables12_13():
    for n_val, label in [(100,"TABLE 12"),(500,"TABLE 13")]:
        print(f"\n{'='*58}")
        print(f"{label} — Threshold Sensitivity (n={n_val}, λ=1%)")
        print("="*58)
        print(f"{'Fth':>5} | {'k*':>8} | {'PDR%':>8} | Failures tolerated")
        print("-"*58)
        for fth in sorted(FIDELITY_THRESHOLDS, reverse=True):
            r      = run_experiment(n_val, 0.01, fth)
            k_star = int(np.ceil(fth * n_val))
            print(f"{fth:>5.2f} | {k_star:>3}/{n_val:<4} | "
                  f"{r['pdr_fidelity_pct']:>8.1f} | "
                  f"Up to {n_val - k_star} failures")


