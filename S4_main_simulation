def print_table8_9():
    print("\n" + "="*78)
    print("TABLE 8 & 9 — ACK Overhead and Latency  (lambda=1%, Fth=0.90)")
    print("="*78)
    print(f"{'n':>6} | {'TCP KB':>10} | {'CAAF KB':>8} | {'Red%':>7} | "
          f"{'TCP ms':>7} | {'CAAF ms':>8} | {'Save ms':>8} | {'Save%':>6}")
    print("-"*78)
    for n in RECEIVER_COUNTS:
        r = run_experiment(n, 0.01, 0.90)
        print(f"{n:>6} | {r['tcp_overhead_kb']:>10.1f} | {r['caaf_overhead_kb']:>8.2f} | "
              f"{r['ack_reduction_pct']:>7.2f} | {r['latency_tcp_ms']:>7.2f} | "
              f"{r['latency_caaf_ms']:>8.2f} | {r['latency_saving_ms']:>8.2f} | "
              f"{r['latency_saving_pct']:>6.1f}")


def print_table10():
