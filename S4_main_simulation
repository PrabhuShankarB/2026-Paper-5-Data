import numpy as np

# ── Simulation parameters (Table 7a) ────────────────────────────────────
RECEIVER_COUNTS     = [10, 50, 100, 250, 500, 750, 1000]
LOSS_RATES          = [0.01, 0.05, 0.10]
FIDELITY_THRESHOLDS = [0.80, 0.85, 0.90, 0.95, 1.00]
PACKETS_PER_TRIAL   = 500
TRIALS              = 5
RANDOM_SEED         = 42

TCP_ACK_SIZE        = 40       # bytes
COLLECTIVE_ACK_SIZE = 8        # bytes
L_BASE              = 10.0     # ms
DELTA               = 0.05     # ms / receiver (TCP)
DELTA_C             = 0.5      # ms constant (QI-CAAF)
R_MAX               = 3
RP_LIMIT            = 2
RELAX_STEP          = 0.02
FTH_MIN             = 0.70


def simulate_one_packet(n, loss_rate, fth, rng):
    """
    Simulate one packet transmission (with up to R_MAX retransmissions).

    Returns
    -------
    dict with fields used to accumulate all paper metrics.
    """
    # Initial reception states — independent Bernoulli trials
    states = (rng.random(n) > loss_rate).astype(int)

    # ── TCP metrics (no retransmission cap — TCP retransmits broadcast) ──
    tcp_successful = int(states.sum())
    tcp_failed     = n - tcp_successful
    # Broadcast retransmission: if any failure, send to ALL n receivers
    tcp_broadcast_retrans = tcp_failed * n   # worst-case broadcast model

    # ── Strict confirmation (Fth = 1.00) ─────────────────────────────────
    gc_strict = 1 if tcp_failed == 0 else 0

    # ── Fidelity-threshold confirmation loop ──────────────────────────────
    current_states = states.copy()
    current_fth    = fth
    r_count        = 0
    gc_fidelity    = 0
    fasro_retrans  = 0
    broadcast_equiv = 0   # what TCP would have sent for same failures

    for attempt in range(R_MAX + 1):
        k      = int(current_states.sum())
        F      = k / n
        Ec     = 1 if F >= current_fth else 0

        if Ec == 1:
            gc_fidelity = 1
            break

        # Ec = 0 — check retransmission budget
        if r_count >= R_MAX:
            break   # round fails

        r_count += 1

        # Adaptive threshold relaxation
        if r_count > RP_LIMIT and current_fth > FTH_MIN:
            current_fth = max(current_fth - RELAX_STEP, FTH_MIN)

        # FASRO: identify failed receivers and retransmit only to them
        failed_mask = (current_states == 0)
        f = int(failed_mask.sum())
        if f == 0:
            gc_fidelity = 1
            break

        fasro_retrans  += f
        broadcast_equiv += n   # TCP would broadcast to all n

        # New Bernoulli trials for failed receivers only
        new_outcomes = (rng.random(f) > loss_rate).astype(int)
        current_states[failed_mask] = new_outcomes

    return {
        "tcp_acks"          : tcp_successful,
        "tcp_bcast_retrans" : tcp_broadcast_retrans,
        "gc_strict"         : gc_strict,
        "gc_fidelity"       : gc_fidelity,
        "fasro_retrans"     : fasro_retrans,
        "broadcast_equiv"   : broadcast_equiv,
    }


def run_experiment(n, loss_rate, fth):
    """
    Run TRIALS × PACKETS_PER_TRIAL rounds; return all paper metrics.
    """
    rng          = np.random.default_rng(RANDOM_SEED)
    total_rounds = TRIALS * PACKETS_PER_TRIAL

    acc = {k: 0 for k in
           ["tcp_acks","tcp_bcast_retrans","gc_strict",
            "gc_fidelity","fasro_retrans","broadcast_equiv"]}

    for _ in range(total_rounds):
        res = simulate_one_packet(n, loss_rate, fth, rng)
        for k in acc:
            acc[k] += res[k]

    tcp_kb   = (acc["tcp_acks"] * TCP_ACK_SIZE) / 1024
    caaf_kb  = (total_rounds    * COLLECTIVE_ACK_SIZE) / 1024
    ack_red  = ((tcp_kb - caaf_kb) / tcp_kb * 100) if tcp_kb > 0 else 0.0

    lat_tcp  = L_BASE + n * DELTA
    lat_caaf = L_BASE + DELTA_C

    pdr_strict   = acc["gc_strict"]   / total_rounds * 100
    pdr_fidelity = acc["gc_fidelity"] / total_rounds * 100

    br = acc["broadcast_equiv"]
    fr = acc["fasro_retrans"]
    retrans_saving = ((br - fr) / br * 100) if br > 0 else 100.0

    return {
        "n"                  : n,
        "lambda"             : loss_rate,
        "fth"                : fth,
        "tcp_acks"           : acc["tcp_acks"],
        "tcp_overhead_kb"    : round(tcp_kb,  1),
        "caaf_overhead_kb"   : round(caaf_kb, 2),
        "ack_reduction_pct"  : round(ack_red, 2),
        "latency_tcp_ms"     : round(lat_tcp,  2),
        "latency_caaf_ms"    : round(lat_caaf, 2),
        "latency_saving_ms"  : round(lat_tcp - lat_caaf, 2),
        "latency_saving_pct" : round((lat_tcp - lat_caaf)/lat_tcp*100, 1),
        "pdr_strict_pct"     : round(pdr_strict,   1),
        "pdr_fidelity_pct"   : round(pdr_fidelity, 1),
        "pdr_recovery_pp"    : round(pdr_fidelity - pdr_strict, 1),
        "fasro_retrans"      : fr,
        "broadcast_retrans"  : br,
        "retrans_saving_pct" : round(retrans_saving, 1),
        "retrans_saving_pkts": max(0, br - fr),
    }


